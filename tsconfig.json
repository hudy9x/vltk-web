{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/client/combat/**/*.ts",
    "src/client/render/**/*.ts",
    "src/client/simulator/**/*.ts",
    "src/client/workers/**/*.ts",
    "src/client/status/**/*.ts",
    "src/client/maps/**/*.ts",
    "src/client/gameplay/horse-trader/**/*.ts"
  ]
}
