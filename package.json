{
  "name": "volamidle-local",
  "version": "1.0.0",
  "private": true,
  "description": "Local Võ Lâm Idle server with SQLite persistence",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node --watch server/index.js",
