{
  "name": "volamidle-local",
  "version": "1.0.0",
  "private": true,
  "description": "Local Võ Lâm Idle server with SQLite persistence",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node tools/build-app.js",
    "dev": "NODE_ENV=development node --watch server/index.js",
    "start": "node server/index.js",
    "db:seed": "node database/seeds/catalog.js",
    "db:inspect": "node tools/inspect-db.js",
    "db:reset": "node tools/reset-db.js",
    "assets:repair": "node tools/download-assets.js --existing",
    "assets:download": "node tools/download-assets.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "acorn": "8.19.0"
  }
}
