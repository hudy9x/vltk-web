{
  "name": "volamidle-local",
  "version": "1.0.0",
  "private": true,
  "description": "Local Võ Lâm Idle server with SQLite persistence",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run typecheck && node tools/build-app.js",
    "dev": "NODE_ENV=development node --watch server/index.js",
    "dev:combat": "DB_PATH=database/combat-test.sqlite PORT=3001 NODE_ENV=development node --watch server/index.js",
    "dev:arena": "DB_PATH=database/combat-arena.sqlite PORT=3002 COMBAT_SANDBOX=1 NODE_ENV=development node --watch server/index.js",
    "start": "node server/index.js",
    "db:seed": "node database/seeds/catalog.js",
    "db:inspect": "node tools/inspect-db.js",
    "db:reset": "node tools/reset-db.js",
    "assets:repair": "node tools/download-assets.js --existing",
    "assets:download": "node tools/download-assets.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "1.6.0",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
